Public Sub CadastroShow()

    Dim senhaCorreta    As String
    Dim senhaInformada  As String
    
    ' Definir a senha correta
    senhaCorreta = "123"
    
    ' Solicitar a senha ao usuário
    senhaInformada = InputBox("Digite a senha para acessar o formulário:", "Acesso Restrito")
    
    ' Verificar se a senha informada está correta
    If senhaInformada = senhaCorreta Then
        ' Se a senha estiver correta, exibe o formulário
        Cadastro.Show
    Else
        ' Se a senha estiver incorreta, exibe uma mensagem
        MsgBox "Senha incorreta! O acesso foi negado.", vbCritical, "Acesso Negado"
    End If

End Sub


